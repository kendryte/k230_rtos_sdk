menuconfig FAST_BOOT_CONFIGURATION
    bool "Fast Boot Configuration"
    default y

    if FAST_BOOT_CONFIGURATION

        config FAST_BOOT_FILE_PATH
        string "Fast boot file path"
        default "${SDK_BUILD_IMAGES_DIR}/sdcard/micropython"
        help
            Path to the file to be packaged as rtapp.elf.gz, you can use absolute path
            Or you can use ${SDK_*} variables which will be expanded at build time.
            Example: ${SDK_BUILD_IMAGES_DIR}/sdcard/micropython

        config FAST_BOOT_DELETE_ORIGIIN_FILE
            bool "Delete Origin Fastboot App"
            default y
            help
                Delete the original Fast boot file, so it will not exists in filesystem.

        config FAST_BOOT_QUIET
            bool "Reduce boot banners and DDR training progress logs"
            default y
            help
                Suppress DDR initialization banners and training progress
                when building U-Boot from source, and the OpenSBI banner
                when building OpenSBI from source. Prebuilt firmware keeps
                its compiled logging behavior. RT-Smart prints only
                one line with SDK and nncase versions instead of the full banner.
                DDR errors and the MicroPython entry timestamp remain visible.
                Disable to see DDR progress and the full version banner.

    endif
